      "name": "Set Topic Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ api_key: $env.TAVILY_API_KEY, query: $json.topic, search_depth: 'basic', max_results: 5, include_answer: true }) }}",
        "options": {}
      },
      "id": "b18b44bb-c67d-472e-8a19-b6dc24523a65",
      "name": "Search Tavily API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "let resultsOut = [];\nfor (const item of $input.all()) {\n  const tavilyResponse = item.json;\n  // Fallback to topic from previous node if available\n  let topic = \"Unknown\";\n  try { topic = $('Set Topic Input').first().json.topic; } catch(e) {}\n\n  const results = tavilyResponse.results || [];\n  const answer = tavilyResponse.answer || (results.length > 0 ? results[0].content : \"No summary available.\");\n\n  const sources = results.map(r => ({\n    url: r.url,\n    title: r.title,\n    snippet: r.content\n  }));\n\n  // derive 2-4 short facts from result snippets\n  const key_facts = results.slice(0, 3).map(r => r.content.substring(0, 100) + '...');\n\n  const research = {\n    status: \"completed\",\n    sources: sources,\n    summary: answer,\n    key_facts: key_facts,\n    completed_at: new Date().toISOString()\n  };\n\n  resultsOut.push({\n    json: {\n      topic: topic,\n      research: research\n    }\n  });\n}\nreturn resultsOut;"
      },
      "id": "96c3f15c-3bd5-408a-b9c2-55099307d87f",
      "name": "Format Research Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.research.sources.length >= 3 && $json.research.summary.trim() !== '' }}",
              "value2": true
            }
          ]
        }
      },
      "id": "validate-quality-node",
      "name": "Validate Research Quality",
      "type": "n8n-nodes-base.if",
