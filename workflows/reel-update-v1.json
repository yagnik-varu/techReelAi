    {
      "parameters": {
        "jsCode": "const merged = $input.all()[0].json;\nconst updatePayload = merged.update;\nconsole.log(\"updatePayload\",updatePayload)\n\n// Everything except reel_id/update is the existing reel's own\n// top-level fields, flattened in by the Merge node\nconst existingReel = { ...merged };\ndelete existingReel.reel_id;\ndelete existingReel.update;\n\nconst updatedReel = { ...existingReel };\nfor (const key of Object.keys(updatePayload)) {\n  console.log(\"key\",key)\n if (typeof updatePayload[key] === 'object' && updatePayload[key] !== null && updatedReel[key]) {\n   updatedReel[key] = { ...updatedReel[key], ...updatePayload[key] };\n } else {\n   updatedReel[key] = updatePayload[key];\n   console.log('key',key)\n   console.log('updatedReel[key]',updatedReel[key])\n   console.log(\"updatePayload[key]\",updatePayload[key])\n   \n }\n}\nupdatedReel.updated_at = new Date().toISOString();\n\nreturn [{ json: {\n id: updatedReel.id, topic: updatedReel.topic, status: updatedReel.status,\n created_at: updatedReel.created_at, updated_at: updatedReel.updated_at,\n data: JSON.stringify(updatedReel)\n}}];"
      },
